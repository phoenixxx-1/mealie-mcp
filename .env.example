# Mealie MCP Server Configuration
# Copy this file to .env and fill in your values

# Mealie instance URL (no trailing slash)
MEALIE_URL=https://your-mealie-instance.com

# API token from Mealie (User Settings > API Tokens)
MEALIE_API_TOKEN=your-api-token-here

# Optional: folders image_path may read images from, ":"-separated.
# Leave unset to disable image_path. In Docker, mount each folder read-only
# at the same path, e.g. -v /home/you/agent/cache/images:/home/you/agent/cache/images:ro
# MEALIE_MCP_IMAGE_DIRS=/home/you/agent/cache/images
